--- a/tests/test_custom_repr.py
+++ b/tests/test_custom_repr.py
@@ -0,0 +1,50 @@
+import io
+
+import pysnooper
+
+
+def traced_output(function, custom_repr):
+    output = io.StringIO()
+    tracer = pysnooper.snoop(output, custom_repr=custom_repr)
+    tracer(function)()
+    return output.getvalue()
+
+
+def test_single_type_pair_and_subclasses():
+    class MyList(list):
+        pass
+
+    def function():
+        value = MyList([1, 2, 3])
+
+    output = traced_output(function, (list, lambda value: str(len(value))))
+    assert 'value = 3' in output
+
+
+def test_predicate_and_first_matching_formatter():
+    def function():
+        value = [1, 2, 3]
+
+    custom_repr = (
+        (lambda value: isinstance(value, list), lambda value: 'first'),
+        (list, lambda value: 'second'),
+    )
+    output = traced_output(function, custom_repr)
+    assert 'value = first' in output
+    assert 'value = second' not in output
+
+
+def test_unmatched_values_keep_default_repr():
+    def function():
+        value = 'ordinary'
+
+    output = traced_output(function, (list, lambda value: 'custom'))
+    assert "value = 'ordinary'" in output
+
+
+def test_custom_repr_output_is_shortened():
+    def function():
+        value = []
+
+    output = traced_output(function, (list, lambda value: 'x' * 150))
+    assert 'value = ' + ('x' * 48) + '...' + ('x' * 49) in output
