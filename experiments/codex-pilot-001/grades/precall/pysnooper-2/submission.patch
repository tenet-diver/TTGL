+def get_value_repr(value, custom_repr):
+    for condition, formatter in custom_repr:
+        try:
+            matches = isinstance(value, condition) if isinstance(condition, type) else condition(value)
+            if matches:
+                result = formatter(value)
+                if not isinstance(result, pycompat.string_types):
+                    result = pycompat.text_type(result)
+                return utils.truncate(result.replace('\r', '').replace('\n', ''),
+                                      utils.MAX_VARIABLE_LENGTH)
+        except Exception:
+            continue
+    return utils.get_shortish_repr(value)
