+def test_disabled_total_and_truthiness():
+    """Disabled bars retain the metadata used by enabled bars."""
+    with closing(StringIO()) as our_file:
+        inferred = tqdm(_range(3), file=our_file, disable=True)
+        assert inferred.total == 3
+        assert bool(inferred)
+
+        explicit = tqdm(total=3, file=our_file, disable=True)
+        assert explicit.total == 3
+        assert bool(explicit)
+
+        empty = tqdm(total=0, file=our_file, disable=True)
+        assert not bool(empty)
