+def test_disabled_total_and_truth_value():
+    """Disabled bars retain inferred and explicit totals."""
+    with closing(StringIO()) as our_file:
+        inferred = tqdm([1, 2, 3], file=our_file, disable=True)
+        assert inferred.total == 3
+        assert bool(inferred)
+
+        explicit = tqdm(iter([1, 2, 3]), total=3, file=our_file,
+                        disable=True)
+        assert explicit.total == 3
+        assert bool(explicit)
+
+        manual = tqdm(total=0, file=our_file, disable=True)
+        assert manual.total == 0
+        assert not bool(manual)
+
+        for progressbar in (inferred, explicit, manual):
+            progressbar.close()
+
+
