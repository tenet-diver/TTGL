+    def __bool__(self):
+        """Return whether the known total or iterable is nonempty."""
+        if self.iterable is not None:
+            if hasattr(self.iterable, "shape"):
+                return bool(self.iterable.shape[0])
+            if hasattr(self.iterable, "__len__"):
+                return bool(len(self.iterable))
+            # An unsized iterable cannot be checked without consuming it.
+            return True if self.total is None else bool(self.total)
+        return bool(self.total)
+
+    __nonzero__ = __bool__
+
     def __enter__(self):
         return self
 
