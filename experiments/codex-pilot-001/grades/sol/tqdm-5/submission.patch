+"""Disabled bars retain the total and length behavior of enabled bars."""
+from __future__ import unicode_literals
+
+from io import StringIO
+from unittest import TestCase
+
+from tqdm import tqdm
+
+
+class TestDisabledTotal(TestCase):
+    def check_bar(self, iterable, total, expected_total, expected_length):
+        for disable in (False, True, None):
+            output = StringIO()
+            with tqdm(iterable, total=total, disable=disable,
+                      file=output) as bar:
+                self.assertEqual(bar.total, expected_total)
+                self.assertEqual(len(bar), expected_length)
+                self.assertEqual(bool(bar), bool(expected_length))
+            if disable is not False:
+                self.assertEqual(output.getvalue(), '')
+
+    def test_inferred_total(self):
+        self.check_bar([1, 2, 3], None, 3, 3)
+        self.check_bar([], None, 0, 0)
+
+    def test_explicit_total_without_iterable(self):
+        self.check_bar(None, 5, 5, 5)
+        self.check_bar(None, 0, 0, 0)
+
+    def test_explicit_total_overrides_inference(self):
+        self.check_bar([1, 2, 3], 8, 8, 3)
+        self.check_bar([1, 2, 3], 0, 0, 3)
+
+    def test_unsized_iterable_with_total(self):
+        self.check_bar(iter([1, 2, 3]), 5, 5, 5)
+        self.check_bar(iter([]), 0, 0, 0)
+
+    def test_unknown_total(self):
+        for iterable in (None, iter([1, 2, 3])):
+            for disable in (False, True, None):
+                with tqdm(iterable, disable=disable, file=StringIO()) as bar:
+                    self.assertIsNone(bar.total)
+                    self.assertRaises(TypeError, len, bar)
+                    self.assertRaises(TypeError, bool, bar)
