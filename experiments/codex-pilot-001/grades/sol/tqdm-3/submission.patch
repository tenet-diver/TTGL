+"""Regression tests for progress bar truth values."""
+try:
+    from StringIO import StringIO
+except ImportError:
+    from io import StringIO
+
+from nose.tools import assert_raises
+
+from tqdm import tqdm
+
+
+def test_known_total_truth():
+    for disable in (False, True):
+        for total in (0, -1, 0.5, 2):
+            # An explicit total takes precedence over the iterable's length.
+            for iterable in (None, [], [1], iter([1])):
+                with tqdm(iterable, total=total, disable=disable,
+                          file=StringIO()) as bar:
+                    assert bool(bar) is (total > 0)
+                    assert bar.__nonzero__() is (total > 0)
+
+
+def test_unsized_iterable_truth_preserves_iteration():
+    for disable in (False, True):
+        for values in ([], [0, 1]):
+            iterable = (value for value in values)
+            with tqdm(iterable, disable=disable, file=StringIO()) as bar:
+                assert bool(bar) is True
+                assert bar.__nonzero__() is True
+                assert list(bar) == values
+
+
+def test_iterable_custom_truth():
+    class EmptyIterable(object):
+        def __iter__(self):
+            return iter([])
+
+        def __bool__(self):
+            return False
+
+        __nonzero__ = __bool__
+
+    for disable in (False, True):
+        with tqdm(EmptyIterable(), disable=disable, file=StringIO()) as bar:
+            assert bool(bar) is False
+            assert bar.__nonzero__() is False
+
+
+def test_undefined_truth():
+    for disable in (False, True):
+        with tqdm(disable=disable, file=StringIO()) as bar:
+            with assert_raises(TypeError) as error:
+                bool(bar)
+            assert str(error.exception) == (
+                'bool() undefined when iterable == total == None')
+            assert_raises(TypeError, bar.__nonzero__)
