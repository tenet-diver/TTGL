--- a/tests/test_custom_repr.py
+++ b/tests/test_custom_repr.py
@@ -0,0 +1,83 @@
+import io
+
+import pytest
+
+import pysnooper
+from pysnooper.utils import get_shortish_repr, truncate, MAX_VARIABLE_LENGTH
+
+
+@pytest.mark.parametrize('custom_repr', [
+    (list, lambda value: str(len(value))),
+    [list, lambda value: str(len(value))],
+    ((list, lambda value: str(len(value))),),
+    [(list, lambda value: str(len(value)))],
+    (lambda value: isinstance(value, list), lambda value: str(len(value))),
+    ((lambda value: False, lambda value: 'wrong'),
+     (lambda value: isinstance(value, list), lambda value: str(len(value))),
+     (list, lambda value: 'too late')),
+])
+def test_custom_repr_local_values(custom_repr):
+    output = io.StringIO()
+
+    @pysnooper.snoop(output=output, custom_repr=custom_repr)
+    def traced(values):
+        count = 7
+        values.append(count)
+        return count
+
+    values = [1, 2]
+    assert traced(values) == 7
+    lines = output.getvalue().splitlines()
+    assert 'Starting var:.. values = 2' in lines
+    assert 'Modified var:.. values = 3' in lines
+    assert 'New var:....... count = 7' in lines
+
+
+def test_custom_repr_type_matches_subclasses_and_uses_first_match():
+    class ListSubclass(list):
+        pass
+
+    output = io.StringIO()
+
+    @pysnooper.snoop(output=output, custom_repr=(
+        (list, lambda value: 'first'),
+        (object, lambda value: 'second'),
+    ))
+    def traced(values):
+        return values
+
+    values = ListSubclass([1, 2])
+    assert traced(values) is values
+    assert 'Starting var:.. values = first' in output.getvalue().splitlines()
+
+
+def test_custom_repr_keeps_default_behavior_on_other_tracers():
+    output = io.StringIO()
+
+    @pysnooper.snoop(output=output, custom_repr=(list, lambda value: 'custom'))
+    def custom(values):
+        return values
+
+    @pysnooper.snoop(output=output)
+    def default(values):
+        return values
+
+    custom([1])
+    default([1])
+    lines = output.getvalue().splitlines()
+    assert 'Starting var:.. values = custom' in lines
+    assert 'Starting var:.. values = [1]' in lines
+
+
+def test_custom_repr_preserves_cleanup_and_failure_handling():
+    formatted = 'start\r\n' + 'x' * 150 + 'end'
+    assert get_shortish_repr([], ((list, lambda value: formatted),)) == (
+        truncate(formatted.replace('\r', '').replace('\n', ''),
+                 MAX_VARIABLE_LENGTH)
+    )
+
+    def broken_formatter(value):
+        raise ValueError('cannot format')
+
+    assert get_shortish_repr([], ((list, broken_formatter),)) == 'REPR FAILED'
+    assert get_shortish_repr(7, ((list, broken_formatter),)) == '7'
