+from io import StringIO
+from multiprocessing.pool import ThreadPool
+
+import pytest
+
+from tqdm import tqdm
+
+
+def test_disabled_imap_can_be_collected():
+    pool = ThreadPool(1)
+    try:
+        bar = tqdm(pool.imap(abs, [-1, -2, -3]), disable=True)
+        with pytest.raises(TypeError):
+            len(bar)
+        assert list(bar) == [1, 2, 3]
+    finally:
+        pool.close()
+        pool.join()
+
+
+def test_disabled_generator_can_be_collected():
+    assert list(tqdm((i for i in range(3)), disable=True)) == [0, 1, 2]
+
+
+def test_disabled_manual_length_is_unknown():
+    with pytest.raises(TypeError):
+        len(tqdm(disable=True))
+
+
+@pytest.mark.parametrize('disable', [False, True])
+def test_sized_iterable_length_and_iteration(disable):
+    with tqdm([1, 2, 3], disable=disable, file=StringIO()) as bar:
+        assert len(bar) == 3
+        assert list(bar) == [1, 2, 3]
+
+
+def test_manual_length():
+    with tqdm(total=3, file=StringIO()) as bar:
+        assert len(bar) == 3
+
+
+def test_enabled_unknown_length_can_be_collected():
+    with tqdm((i for i in range(3)), file=StringIO()) as bar:
+        with pytest.raises(TypeError):
+            len(bar)
+        assert list(bar) == [0, 1, 2]
