+import { HTMLAttributes } from 'react';
+
+import { c } from 'ttag';
+
+import { Href } from '@proton/atoms';
+import { APPS } from '@proton/shared/lib/constants';
+import { getKnowledgeBaseUrl } from '@proton/shared/lib/helpers/url';
+
+import useConfig from '../../hooks/useConfig';
+
+const BitcoinInfoMessage = (rest: HTMLAttributes<HTMLDivElement>) => {
+    const { APP_NAME } = useConfig();
+    return (
+        <div {...rest}>
+            {c('Info')
+                .t`To pay with Bitcoin, send the exact BTC amount to the address above. Bitcoin transactions can take up to 24 hours to be confirmed.`}
+            <div>
+                <Href
+                    href={
+                        APP_NAME === APPS.PROTONVPN_SETTINGS
+                            ? 'https://protonvpn.com/support/vpn-bitcoin-payments/'
+                            : getKnowledgeBaseUrl('/pay-with-bitcoin')
+                    }
+                >{c('Link').t`Learn more`}</Href>
+            </div>
+        </div>
+    );
+};
+
+export default BitcoinInfoMessage;
