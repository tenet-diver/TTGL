@@ -0,0 +1,187 @@
+import { ComponentProps } from 'react';
+
+import { act, fireEvent, render } from '@testing-library/react';
+
+import { PAYMENT_TOKEN_STATUS } from '@proton/components/payments/core';
+import { createToken, getTokenStatus } from '@proton/shared/lib/api/payments';
+import { APPS } from '@proton/shared/lib/constants';
+import { addApiMock, addApiResolver, apiMock, clearApiMocks } from '@proton/testing/lib/api';
+import { flushPromises } from '@proton/testing/lib/flush-promises';
+
+import ApiContext from '../api/apiContext';
+import ConfigContext from '../config/configContext';
+import Bitcoin from './Bitcoin';
+import BitcoinInfoMessage from './BitcoinInfoMessage';
+
+const config = { APP_NAME: APPS.PROTONMAIL } as any;
+const ContextBitcoin = (props: ComponentProps<typeof Bitcoin>) => (
+    <ApiContext.Provider value={apiMock}>
+        <ConfigContext.Provider value={config}>
+            <Bitcoin {...props} />
+        </ConfigContext.Provider>
+    </ApiContext.Provider>
+);
+const ContextInfo = (props: ComponentProps<typeof BitcoinInfoMessage>) => (
+    <ConfigContext.Provider value={config}>
+        <BitcoinInfoMessage {...props} />
+    </ConfigContext.Provider>
+);
+const response = { Token: 'token-123', Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' } };
+const props = { amount: 5000, currency: 'EUR' as const, type: 'subscription', awaitingPayment: false };
+const statusMock = jest.fn();
+
+beforeEach(() => {
+    jest.useFakeTimers({ legacyFakeTimers: true });
+    clearApiMocks();
+    apiMock.mockClear();
+    statusMock.mockReset().mockResolvedValue({ Status: PAYMENT_TOKEN_STATUS.STATUS_PENDING });
+    addApiMock(createToken({} as any).url, () => response);
+    addApiMock(getTokenStatus(response.Token).url, statusMock);
+});
+
+afterEach(() => {
+    jest.useRealTimers();
+});
+
+const settle = () =>
+    act(async () => {
+        await flushPromises();
+    });
+const advance = async (ms: number) => {
+    act(() => {
+        jest.advanceTimersByTime(ms);
+    });
+    await settle();
+};
+
+it('shows a loader until token details arrive and displays the exact deposit values', async () => {
+    const resolve = addApiResolver(createToken({} as any).url);
+    const { getByTestId, queryByTestId, container } = render(<ContextBitcoin {...props} enableValidation />);
+    expect(getByTestId('circle-loader')).toBeInTheDocument();
+    expect(apiMock).toHaveBeenCalledWith(
+        createToken({
+            Amount: props.amount,
+            Currency: props.currency,
+            Payment: { Type: 'cryptocurrency', Details: { Coin: 'bitcoin' } },
+        })
+    );
+    await advance(30000);
+    expect(statusMock).not.toHaveBeenCalled();
+    resolve(response);
+    await settle();
+    expect(queryByTestId('circle-loader')).not.toBeInTheDocument();
+    expect(container).toHaveTextContent('address-123');
+    expect(container).toHaveTextContent('0.00135');
+});
+
+it('waits ten seconds, keeps polling pending tokens, and validates exactly once', async () => {
+    const onTokenValidated = jest.fn();
+    const { rerender } = render(<ContextBitcoin {...props} enableValidation onTokenValidated={onTokenValidated} />);
+    await settle();
+    await advance(9999);
+    expect(statusMock).not.toHaveBeenCalled();
+    await advance(1);
+    expect(statusMock).toHaveBeenCalledTimes(1);
+    expect(statusMock).toHaveBeenLastCalledWith(getTokenStatus('token-123'));
+    expect(onTokenValidated).not.toHaveBeenCalled();
+    await advance(10000);
+    expect(statusMock).toHaveBeenCalledTimes(2);
+    statusMock.mockResolvedValue({ Status: PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE });
+    await advance(10000);
+    expect(onTokenValidated).toHaveBeenCalledTimes(1);
+    rerender(<ContextBitcoin {...props} enableValidation={false} onTokenValidated={onTokenValidated} />);
+    rerender(<ContextBitcoin {...props} enableValidation onTokenValidated={onTokenValidated} />);
+    await advance(30000);
+    expect(statusMock).toHaveBeenCalledTimes(3);
+    expect(onTokenValidated).toHaveBeenCalledTimes(1);
+});
+
+it('only starts polling when validation is enabled and clears the timer on unmount', async () => {
+    const { rerender, unmount } = render(<ContextBitcoin {...props} />);
+    await settle();
+    await advance(20000);
+    expect(statusMock).not.toHaveBeenCalled();
+    rerender(<ContextBitcoin {...props} enableValidation />);
+    await advance(10000);
+    expect(statusMock).toHaveBeenCalledTimes(1);
+    unmount();
+    await advance(30000);
+    expect(statusMock).toHaveBeenCalledTimes(1);
+});
+
+it('does not overlap slow status requests or validate after unmount', async () => {
+    const resolve = addApiResolver(getTokenStatus(response.Token).url);
+    const onTokenValidated = jest.fn();
+    const { unmount } = render(<ContextBitcoin {...props} enableValidation onTokenValidated={onTokenValidated} />);
+    await settle();
+    await advance(10000);
+    const calls = apiMock.mock.calls.length;
+    await advance(30000);
+    expect(apiMock).toHaveBeenCalledTimes(calls);
+    unmount();
+    resolve({ Status: PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE });
+    await settle();
+    expect(onTokenValidated).not.toHaveBeenCalled();
+});
+
+it('allows retrying a failed token request', async () => {
+    const create = jest.fn().mockRejectedValueOnce(new Error('offline')).mockResolvedValue(response);
+    addApiMock(createToken({} as any).url, create);
+    const { getByText, container } = render(<ContextBitcoin {...props} />);
+    await settle();
+    fireEvent.click(getByText('Try again'));
+    await settle();
+    expect(container).toHaveTextContent('address-123');
+    expect(create).toHaveBeenCalledTimes(2);
+});
+
+it('keeps watching after a temporary status request failure', async () => {
+    const onTokenValidated = jest.fn();
+    statusMock.mockRejectedValueOnce(new Error('offline'));
+    statusMock.mockResolvedValue({ Status: PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE });
+    render(<ContextBitcoin {...props} enableValidation onTokenValidated={onTokenValidated} />);
+    await settle();
+    await advance(10000);
+    expect(onTokenValidated).not.toHaveBeenCalled();
+    await advance(10000);
+    expect(statusMock).toHaveBeenCalledTimes(2);
+    expect(onTokenValidated).toHaveBeenCalledTimes(1);
+});
+
+it('ignores old deposit details if the currency changes while creating a token', async () => {
+    const resolveOld = addApiResolver(createToken({} as any).url);
+    const { rerender, container } = render(<ContextBitcoin {...props} enableValidation />);
+    const next = { Token: 'next-token', Data: { CoinAddress: 'next-address', CoinAmount: '0.002' } };
+    const nextStatus = jest.fn().mockResolvedValue({ Status: PAYMENT_TOKEN_STATUS.STATUS_PENDING });
+    addApiMock(createToken({} as any).url, () => next);
+    addApiMock(getTokenStatus(next.Token).url, nextStatus);
+    rerender(<ContextBitcoin {...props} currency="USD" enableValidation />);
+    await settle();
+    resolveOld(response);
+    await settle();
+    expect(container).toHaveTextContent('next-address');
+    expect(container).not.toHaveTextContent('address-123');
+    await advance(10000);
+    expect(nextStatus).toHaveBeenCalledTimes(1);
+    expect(statusMock).not.toHaveBeenCalled();
+});
+
+it.each([true, false])('flushes nested promises without advancing %s legacy fake timers', async (legacyFakeTimers) => {
+    jest.useRealTimers();
+    jest.useFakeTimers({ legacyFakeTimers });
+    let finished = false;
+    Promise.resolve().then(() =>
+        Promise.resolve().then(() => {
+            finished = true;
+        })
+    );
+    await flushPromises();
+    expect(finished).toBe(true);
+});
+
+it('spreads attributes onto the instruction container and links to Bitcoin help', () => {
+    const { getByTestId, getByRole } = render(<ContextInfo data-testid="instructions" className="info" />);
+    expect(getByTestId('instructions')).toHaveClass('info');
+    expect(getByTestId('instructions')).toHaveTextContent('send the exact BTC amount to the address above');
+    expect(getByRole('link')).toHaveAttribute('href', expect.stringContaining('/pay-with-bitcoin'));
+});
