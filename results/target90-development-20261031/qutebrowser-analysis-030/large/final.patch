+@pytest.mark.parametrize('favorites', [[], ['/some/dir'],
+                                     ['~/z', '/some/dir', '/some/dir']])
+@pytest.mark.parametrize('enabled', [False, True])
+def test_filesystem_favorites(config_stub, info, qtmodeltester,
+                              quickmarks, bookmarks, web_history_populated,
+                              favorites, enabled):
+    """Favorites retain order, spelling and duplicates without changing URLs."""
+    categories = ['quickmarks', 'bookmarks', 'history']
+    config_stub.val.completion.open_categories = categories
+    baseline = urlmodel.url(info=info)
+    baseline.set_pattern('')
+    expected = {}
+    for row in range(baseline.rowCount()):
+        parent = baseline.index(row, 0)
+        expected[baseline.data(parent)] = [
+            tuple(baseline.data(baseline.index(i, col, parent))
+                  for col in range(3))
+            for i in range(baseline.rowCount(parent))]
+
+    config_stub.val.completion.favorite_paths = favorites
+    if enabled:
+        config_stub.val.completion.open_categories = ['filesystem'] + categories
+        expected['Filesystem'] = [(path, None, None) for path in favorites]
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    _check_completions(model, expected)
+    if enabled:
+        assert model.data(model.index(0, 0)) == 'Filesystem'
+
+
+def test_filesystem_directory(config_stub, info, qtmodeltester, tmp_path,
+                              quickmark_manager_stub, bookmark_manager_stub):
+    """List direct children by name, then clear stale matches and restore favorites."""
+    config_stub.val.completion.open_categories = ['filesystem']
+    config_stub.val.completion.favorite_paths = ['/favorite']
+    tmp_path = tmp_path / 'files'
+    tmp_path.mkdir()
+    (tmp_path / 'file2.txt').touch()
+    (tmp_path / 'file1.txt').touch()
+    (tmp_path / 'directory').mkdir()
+    (tmp_path / 'directory' / 'nested').touch()
+    val = str(tmp_path) + os.sep
+    model = urlmodel.url(info=info)
+    model.set_pattern(val)
+    qtmodeltester.check(model)
+    _check_completions(model, {'Filesystem': [
+        (val + name, None, None)
+        for name in ['directory', 'file1.txt', 'file2.txt']]})
+
+    model.set_pattern(val + 'file1')
+    _check_completions(model, {'Filesystem': [(val + 'file1.txt', None, None)]})
+    model.set_pattern(val + 'missing' + os.sep)
+    _check_completions(model, {'Filesystem': []})
+    model.set_pattern('https://example.org/')
+    _check_completions(model, {'Filesystem': []})
+    model.set_pattern('')
+    _check_completions(model, {'Filesystem': [('/favorite', None, None)]})
+
+
+def test_filesystem_defaults(config_stub, info, quickmark_manager_stub,
+                             bookmark_manager_stub):
+    """Filesystem is enabled by default even with no favorites or web history."""
+    assert config_stub.val.completion.favorite_paths == []
+    assert config_stub.val.completion.open_categories == [
+        'searchengines', 'quickmarks', 'bookmarks', 'history', 'filesystem']
+    config_stub.val.completion.web_history.max_items = 0
+    config_stub.val.completion.open_categories = ['filesystem']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    _check_completions(model, {'Filesystem': []})
+
+
+@pytest.mark.parametrize('kind', ['file-url', 'home'])
+def test_filesystem_path_forms(config_stub, info, tmp_path, monkeypatch,
+                               quickmark_manager_stub, bookmark_manager_stub,
+                               kind):
+    """File URLs and home-relative paths can complete a filename prefix."""
+    config_stub.val.completion.open_categories = ['filesystem']
+    directory = tmp_path / 'files'
+    directory.mkdir()
+    (directory / 'page one.html').touch()
+    (directory / 'other.html').touch()
+    if kind == 'file-url':
+        pattern = QUrl.fromLocalFile(str(directory)).toString() + '/page'
+        expected = QUrl.fromLocalFile(
+            str(directory / 'page one.html')).toString()
+    else:
+        monkeypatch.setenv('HOME', str(tmp_path))
+        pattern = '~/files/page'
+        expected = '~/files/page one.html'
+    model = urlmodel.url(info=info)
+    model.set_pattern(pattern)
+    _check_completions(model, {'Filesystem': [(expected, None, None)]})
