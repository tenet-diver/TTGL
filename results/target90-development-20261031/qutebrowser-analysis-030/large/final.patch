+"""Completion category for local filesystem paths."""
+
+import os
+from typing import List, Optional
+
+from PyQt5.QtCore import QAbstractListModel, QModelIndex, Qt, QUrl
+
+from qutebrowser.config import config
+
+
+class FilePathCategory(QAbstractListModel):
+
+    """Suggest favorite paths or entries matching a local path prefix."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.name = 'Filesystem'
+        self.columns_to_filter = [0]
+        self.delete_func = None
+        self._paths: List[str] = []
+
+    def set_pattern(self, val: str) -> None:
+        """Update suggestions for the partially typed path or file URL."""
+        paths = []
+        if not val:
+            paths = list(config.val.completion.favorite_paths)
+        else:
+            is_url = val.startswith('file://')
+            path = QUrl(val).toLocalFile() if is_url else val
+            expanded = os.path.expanduser(path)
+            if os.path.isabs(expanded):
+                directory, prefix = os.path.split(expanded)
+                typed_directory = path[:len(path) - len(prefix)]
+                try:
+                    names = sorted(os.listdir(directory))
+                except OSError:
+                    # Missing or unreadable directories have no suggestions.
+                    names = []
+                for name in names:
+                    if name.startswith(prefix):
+                        suggestion = typed_directory + name
+                        if is_url:
+                            suggestion = QUrl.fromLocalFile(suggestion).toString()
+                        paths.append(suggestion)
+
+        self.beginResetModel()
+        self._paths = paths
+        self.endResetModel()
+
+    def data(self, index: QModelIndex,
+             role: int = Qt.DisplayRole) -> Optional[str]:
+        """Return the path for a display index, with no other column data."""
+        if (role != Qt.DisplayRole or not index.isValid() or
+                index.column() != 0 or
+                not 0 <= index.row() < len(self._paths)):
+            return None
+        return self._paths[index.row()]
+
+    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:
+        """Return the number of paths (list entries have no children)."""
+        return 0 if parent.isValid() else len(self._paths)
