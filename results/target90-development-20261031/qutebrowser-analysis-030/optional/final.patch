+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Completion category for local filesystem paths."""
+
+import os
+from typing import Optional
+
+from PyQt5.QtCore import QAbstractListModel, QModelIndex, Qt
+
+
+class FilePathCategory(QAbstractListModel):
+    """Expose favorite paths or entries in a typed absolute directory."""
+
+    def __init__(self, favorite_paths, parent=None):
+        super().__init__(parent)
+        self.name = 'Filesystem'
+        self.favorite_paths = favorite_paths
+        self.paths = []
+        self.columns_to_filter = []
+        self.delete_func = None
+
+    def set_pattern(self, val: str) -> None:
+        if val == '':
+            paths = list(self.favorite_paths)
+        elif os.path.isabs(val) and val.endswith(os.sep) and os.path.isdir(val):
+            try:
+                paths = [val + name for name in sorted(os.listdir(val))]
+            except OSError:
+                paths = []
+        else:
+            paths = []
+        self.beginResetModel()
+        self.paths = paths
+        self.endResetModel()
+
+    def data(self, index: QModelIndex, role: int = Qt.DisplayRole) -> Optional[str]:
+        if not index.isValid() or index.row() < 0 or index.row() >= len(self.paths):
+            return None
+        if role == Qt.DisplayRole:
+            if index.column() == 0:
+                return self.paths[index.row()]
+            return None
+        return None
+
+    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:
+        return 0 if parent.isValid() else len(self.paths)
+
+    def columnCount(self, parent=QModelIndex()):
+        return 3
