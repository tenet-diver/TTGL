+                    ]
+                )
+            ),
+            None,
+        ),
+        (
+            ContentInfo(
+                languages=Languages(
+                    display_values=[
+                        LanguageType(display_value='French', type='Original Language'),
+                        LanguageType(display_value='English', type='Published'),
+                        LanguageType(display_value='English', type='Unknown'),
+                        LanguageType(display_value='Français', type='Published'),
+                        LanguageType(display_value='French', type='Translated'),
+                        LanguageType(display_value='english'),
+                    ]
+                )
+            ),
+            ['English', 'Français', 'French', 'english'],
+        ),
+    ],
+)
+def test_serialize_languages(content_info, expected_languages):
+    product = AmazonAPIReply(
+        item_info=ItemInfo(
+            classifications=None,
+            content_info=content_info,
+            by_line_info=None,
+            title='',
+        ),
+        images='',
+        offers='',
+        asin='0190906766',
+    )
+    result = AmazonAPI.serialize(product)
+    cleaned = clean_amazon_metadata_for_load(result)
+    if expected_languages is None:
+        assert 'languages' not in result
+        assert 'languages' not in cleaned
+    else:
+        assert result['languages'] == expected_languages
+        assert cleaned['languages'] == expected_languages
