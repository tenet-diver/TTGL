@@ -0,0 +1,120 @@
+package agents
+
+import (
+	"context"
+	"errors"
+	"io/ioutil"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/utils/lastfm"
+)
+
+type lastfmSequenceClient struct {
+	requests []*http.Request
+	bodies   []string
+	err      error
+}
+
+func (c *lastfmSequenceClient) Do(req *http.Request) (*http.Response, error) {
+	c.requests = append(c.requests, req)
+	if c.err != nil {
+		return nil, c.err
+	}
+	body := c.bodies[0]
+	if len(c.bodies) > 1 {
+		c.bodies = c.bodies[1:]
+	}
+	return &http.Response{StatusCode: 200, Body: ioutil.NopCloser(strings.NewReader(body))}, nil
+}
+
+func TestLastFMFallback(t *testing.T) {
+	transportErr := errors.New("transport failure")
+	const summary = `Biography <a href="https://last.fm/music/Artist">Read more on Last.fm</a>`
+	operations := []struct {
+		name, success, unknown string
+		call                   func(*lastfmAgent, string) (interface{}, error)
+		want                   interface{}
+	}{
+		{
+			name:    "biography",
+			success: `{"artist":{"name":"Artist","bio":{"summary":"Biography <a href=\"https://last.fm/music/Artist\">Read more on Last.fm</a>"}}}`,
+			unknown: `{"artist":{"name":"[unknown]","bio":{"summary":"placeholder"}}}`,
+			call: func(a *lastfmAgent, mbid string) (interface{}, error) {
+				return a.GetBiography("id", "Artist", mbid)
+			},
+			want: summary,
+		},
+		{
+			name:    "similar",
+			success: `{"similarartists":{"artist":[{"name":"Similar","mbid":"similar-id"}],"@attr":{"artist":"Artist"}}}`,
+			unknown: `{"similarartists":{"artist":[{"name":"placeholder"}],"@attr":{"artist":"[unknown]"}}}`,
+			call: func(a *lastfmAgent, mbid string) (interface{}, error) {
+				return a.GetSimilar("id", "Artist", mbid, 3)
+			},
+			want: []Artist{{Name: "Similar", MBID: "similar-id"}},
+		},
+		{
+			name:    "top songs",
+			success: `{"toptracks":{"track":[{"name":"Song","mbid":"song-id"}],"@attr":{"artist":"Artist"}}}`,
+			unknown: `{"toptracks":{"track":[{"name":"placeholder"}],"@attr":{"artist":"[unknown]"}}}`,
+			call: func(a *lastfmAgent, mbid string) (interface{}, error) {
+				return a.GetTopSongs("id", "Artist", mbid, 3)
+			},
+			want: []Song{{Name: "Song", MBID: "song-id"}},
+		},
+	}
+	for _, op := range operations {
+		t.Run(op.name, func(t *testing.T) {
+			cases := []struct {
+				name, first, second, mbid string
+				transport, wantErr        error
+				count                     int
+			}{
+				{name: "success", first: op.success, mbid: "original", count: 1},
+				{name: "unknown", first: op.unknown, second: op.success, mbid: "original", count: 2},
+				{name: "code 6", first: `{"error":6,"message":"not found"}`, second: op.success, mbid: "original", count: 2},
+				{name: "other API error", first: `{"error":3,"message":"invalid"}`, mbid: "original", wantErr: &lastfm.Error{Code: 3, Message: "invalid"}, count: 1},
+				{name: "transport", mbid: "original", transport: transportErr, wantErr: transportErr, count: 1},
+				{name: "empty MBID unknown", first: op.unknown, wantErr: ErrNotFound, count: 1},
+				{name: "empty MBID code 6", first: `{"error":6,"message":"not found"}`, wantErr: &lastfm.Error{Code: 6, Message: "not found"}, count: 1},
+				{name: "fallback still unknown", first: op.unknown, second: op.unknown, mbid: "original", wantErr: ErrNotFound, count: 2},
+				{name: "fallback still code 6", first: `{"error":6,"message":"not found"}`, second: `{"error":6,"message":"not found"}`, mbid: "original", wantErr: &lastfm.Error{Code: 6, Message: "not found"}, count: 2},
+			}
+			for _, tc := range cases {
+				t.Run(tc.name, func(t *testing.T) {
+					hc := &lastfmSequenceClient{bodies: []string{tc.first}, err: tc.transport}
+					if tc.second != "" {
+						hc.bodies = append(hc.bodies, tc.second)
+					}
+					a := &lastfmAgent{ctx: context.Background(), client: lastfm.NewClient("key", "en", hc)}
+					got, err := op.call(a, tc.mbid)
+					if !errors.Is(err, tc.wantErr) {
+						t.Fatalf("error = %v, want %v", err, tc.wantErr)
+					}
+					if tc.wantErr == nil && !reflect.DeepEqual(got, op.want) {
+						t.Errorf("result = %#v, want %#v", got, op.want)
+					}
+					if len(hc.requests) != tc.count {
+						t.Fatalf("requests = %d, want %d", len(hc.requests), tc.count)
+					}
+					for i, req := range hc.requests {
+						wantMBID := tc.mbid
+						if i > 0 {
+							wantMBID = ""
+						}
+						query := req.URL.Query()
+						if len(query["mbid"]) != 1 || query.Get("mbid") != wantMBID || query.Get("artist") != "Artist" {
+							t.Errorf("request %d query = %v", i, query)
+						}
+						if op.name != "biography" && query.Get("limit") != "3" {
+							t.Errorf("limit = %q, want 3", query.Get("limit"))
+						}
+					}
+				})
+			}
+		})
+	}
+}
