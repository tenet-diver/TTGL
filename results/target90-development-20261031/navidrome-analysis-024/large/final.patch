+// shouldRetry only falls back for unresolved MBIDs, never for transport or other API errors.
+func (l *lastfmAgent) shouldRetry(name, mbid string, unknown bool, err error) bool {
+	var apiErr *lastfm.Error
+	if mbid == "" || !(unknown || (errors.As(err, &apiErr) && apiErr.Code == 6)) {
+		return false
+	}
+	log.Warn(l.ctx, "LastFM could not resolve MBID, retrying by artist name", "artist", name, "mbid", mbid)
+	return true
 }
 
