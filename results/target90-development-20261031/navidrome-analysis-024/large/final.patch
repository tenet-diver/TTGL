index 00000000..1ff000ca
--- /dev/null
+++ b/utils/lastfm/error_handling_test.go
@@ -0,0 +1,54 @@
+package lastfm
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io/ioutil"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestClientResponseErrors(t *testing.T) {
+	for _, status := range []int{200, 400, 500} {
+		for _, code := range []int{3, 6} {
+			body := `{"error":3,"message":"artist unavailable"}`
+			if code == 6 {
+				body = `{"error":6,"message":"artist unavailable"}`
+			}
+			var response Response
+			if err := json.Unmarshal([]byte(body), &response); err != nil || response.Error != code || response.Message != "artist unavailable" {
+				t.Fatalf("structured error: %#v, %v", response, err)
+			}
+			hc := &fakeHttpClient{res: http.Response{StatusCode: status, Body: ioutil.NopCloser(strings.NewReader(body))}}
+			_, err := NewClient("key", "en", hc).ArtistGetInfo(context.Background(), "Artist", "mbid")
+			var apiErr *Error
+			if !errors.As(err, &apiErr) || !errors.Is(err, &Error{Code: code, Message: "artist unavailable"}) {
+				t.Errorf("HTTP %d code %d: got %T %v", status, code, err, err)
+			}
+			if errors.Is(err, &Error{Code: code + 1, Message: "artist unavailable"}) ||
+				errors.Is(err, &Error{Code: code, Message: "different"}) {
+				t.Error("different API errors compared equal")
+			}
+		}
+	}
+	for _, status := range []int{200, 503} {
+		hc := &fakeHttpClient{res: http.Response{StatusCode: status, Body: ioutil.NopCloser(strings.NewReader("<html>"))}}
+		_, err := NewClient("key", "en", hc).ArtistGetInfo(context.Background(), "Artist", "mbid")
+		if status == 200 {
+			var syntaxErr *json.SyntaxError
+			if !errors.As(err, &syntaxErr) {
+				t.Errorf("expected JSON syntax error, got %T %v", err, err)
+			}
+		} else if err == nil || err.Error() != "last.fm http status: (503)" {
+			t.Errorf("unexpected status error: %v", err)
+		}
+	}
+	transportErr := errors.New("transport failure")
+	hc := &fakeHttpClient{err: transportErr}
+	_, err := NewClient("key", "en", hc).ArtistGetInfo(context.Background(), "Artist", "mbid")
+	if err != transportErr {
+		t.Errorf("transport error was changed: %v", err)
+	}
+}
