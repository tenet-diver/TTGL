# Never commit .env.local or real secrets. Services bind loopback by default.
DATABASE_URL=postgresql://observatory:REPLACE_ME@127.0.0.1:15432/observatory
OBS_POSTGRES_PASSWORD=REPLACE_ME
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_DATABASE=observatory
CLICKHOUSE_USER=observatory
CLICKHOUSE_PASSWORD=REPLACE_ME
S3_ENDPOINT=http://127.0.0.1:13900
S3_REGION=garage
S3_BUCKET=observatory-raw
S3_ACCESS_KEY_ID=REPLACE_WITH_GARAGE_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_GARAGE_SECRET
OBS_INGEST_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
# Analysis model is fixed to gpt-6-luna; subscription identity is bound by each local source.
OBS_ALLOW_ANALYSIS=0
NEXT_TELEMETRY_DISABLED=1
