{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimizer.invalid/telemetry.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_family": {
            "type": "string",
            "minLength": 1
          },
          "command_family": {
            "type": "string",
            "minLength": 1
          },
          "success": {
            "type": "boolean"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "model_facing_output_tokens_estimate": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "tokenizer": {
            "type": "string",
            "minLength": 1
          },
          "raw_output_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "source_id",
          "repository_id",
          "session_id",
          "tool_family",
          "command_family",
          "success",
          "duration_ms",
          "model_facing_output_tokens_estimate",
          "tokenizer",
          "raw_output_ref",
          "source_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "window",
    "tool_calls"
  ],
  "additionalProperties": false
}
