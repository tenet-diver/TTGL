digraph TTGL {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.40", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#34516e", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.12"];
  edge [color="#506879", fontname="DejaVu Sans", fontsize=9];
  task [label="User task + explicit constraints"];
  memory [label="Editable personal memory\nPreferences, project state, provenance", fillcolor="#efe5f4"];
  personal [label="Small personal controller\nGoal, work state and remaining budget", fillcolor="#d9e9f8"];
  tools [label="Local tools\nInspect, edit, execute, test"];
  experts [label="Eligible external expert(s)\nPlan advice, patch, critique or subtask"];
  verify [label="Check and integrate\nObservable results + executable evidence"];
  result [label="Final artifact + complete task trace"];
  grader [label="Independent sealed evaluation\nNo final-test feedback to learning", fillcolor="#e6f0df"];
  train [label="Verified development experience\nLocal skills + collaboration learning", fillcolor="#efe5f4"];
  record [label="Cost and provenance ledger\nAll calls, failures and learning costs", fillcolor="#f3eadb"];
  {rank=same; task; memory;}
  {rank=same; tools; experts;}
  {rank=same; train; result;}
  {rank=same; grader; record;}
  task -> personal;
  memory -> personal [label="permitted context"];
  personal -> tools [label="act locally"];
  personal -> experts [label="bounded request"];
  tools -> verify;
  experts -> verify [label="artifact / advice"];
  verify -> personal [label="next action", constraint=false];
  verify -> result;
  verify -> train [style=dashed, label="development only"];
  train -> personal [style=dashed, label="validated new version", constraint=false];
  result -> grader;
  result -> record;
  train -> record [style=dashed, constraint=false];
}
