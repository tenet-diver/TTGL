digraph TTGL {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.35", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#34516e", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.12"];
  edge [color="#506879", fontname="DejaVu Sans", fontsize=9];
  issue [label="Task + pinned environment\nCode or browser objective"];
  harness [label="Common harness within each domain\nWorkspace / browser state and tools"];
  router [label="Portfolio policy + customer budget\nPrimary: one choice per attempt\nExtension: bounded phase handoff", fillcolor="#d9e9f8"];
  local [label="Compact generalist\nLocal or remote"];
  remote [label="Larger generalist\nLocal or remote"];
  specialist [label="Domain specialist(s)\nCode, vision or browser"];
  action [label="Proposed action\nHarness-controlled execution"];
  patch [label="Final artifact / task state + trace"];
  grader [label="Independent benchmark evaluator\nHidden checks isolated from agent", fillcolor="#e6f0df"];
  records [label="Evidence and cost record\nAll calls, failures, timing, hashes", fillcolor="#f3eadb"];
  train [label="Versioned pool + optional adaptation\nCompatible adapter per customer/base", fillcolor="#efe5f4"];
  holdout [label="Separate calibration and final test\nNo training on held-out outcomes", fillcolor="#efe5f4"];
  {rank=same; local; remote; specialist;}
  {rank=same; records; grader;}
  {rank=same; train; holdout;}
  issue -> harness -> router;
  router -> local;
  router -> remote;
  router -> specialist;
  local -> action;
  remote -> action;
  specialist -> action;
  action -> harness [label="visible tool evidence", constraint=false];
  action -> patch -> grader;
  grader -> records;
  router -> records [style=dashed, label="decision and usage", constraint=false];
  train -> router [style=dashed, label="validated configurations", constraint=false];
  train -> holdout [style=dashed, label="independent evaluation"];
  records -> train [style=invis];
  grader -> holdout [style=invis];
}
